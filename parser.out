Grammar:

Rule 0     S' -> program
Rule 1     program -> instructions_opt
Rule 2     instructions_opt -> <empty>
Rule 3     instructions_opt -> instructions
Rule 4     instructions -> instruction
Rule 5     instructions -> instructions instruction
Rule 6     instruction -> FOR variable = range_expr instruction
Rule 7     instruction -> WHILE ( condition ) instruction
Rule 8     instruction -> IF ( condition ) instruction ELSE instruction  [precedence=nonassoc, level=2]
Rule 9     instruction -> IF ( condition ) instruction  [precedence=nonassoc, level=1]
Rule 10    instruction -> statement ;
Rule 11    instruction -> assignment ;
Rule 12    instruction -> { instructions }
Rule 13    assignment -> variable DIVASSIGN expression
Rule 14    assignment -> variable MULASSIGN expression
Rule 15    assignment -> variable SUBASSIGN expression
Rule 16    assignment -> variable ADDASSIGN expression
Rule 17    assignment -> variable = expression
Rule 18    statement -> PRINT expressions
Rule 19    statement -> RETURN expression
Rule 20    statement -> CONTINUE
Rule 21    statement -> BREAK
Rule 22    expressions -> expression
Rule 23    expressions -> expressions , expression
Rule 24    condition -> expression NOTEQ expression
Rule 25    condition -> expression EQUALS expression
Rule 26    condition -> expression MOREEQ expression
Rule 27    condition -> expression LESSEQ expression
Rule 28    condition -> expression < expression
Rule 29    condition -> expression > expression
Rule 30    variable -> ID
Rule 31    variable -> ID vector
Rule 32    expression -> vector
Rule 33    expression -> matrix
Rule 34    expression -> ( expression )
Rule 35    expression -> expression '  [precedence=left, level=8]
Rule 36    expression -> - expression  [precedence=right, level=7]
Rule 37    expression -> expression DOTDIV expression  [precedence=left, level=6]
Rule 38    expression -> expression DOTMUL expression  [precedence=left, level=6]
Rule 39    expression -> expression DOTSUB expression  [precedence=left, level=4]
Rule 40    expression -> expression DOTADD expression  [precedence=left, level=4]
Rule 41    expression -> expression / expression  [precedence=left, level=5]
Rule 42    expression -> expression * expression  [precedence=left, level=5]
Rule 43    expression -> expression - expression  [precedence=left, level=3]
Rule 44    expression -> expression + expression  [precedence=left, level=3]
Rule 45    expression -> variable
Rule 46    expression -> number
Rule 47    expression -> STRING
Rule 48    number -> FLOATNUM
Rule 49    number -> INTNUM
Rule 50    vector -> [ numbers ]
Rule 51    numbers -> number
Rule 52    numbers -> numbers , number
Rule 53    matrix -> EYE ( INTNUM , INTNUM )
Rule 54    matrix -> ONES ( INTNUM , INTNUM )
Rule 55    matrix -> ZEROS ( INTNUM , INTNUM )
Rule 56    matrix -> EYE ( INTNUM )
Rule 57    matrix -> ONES ( INTNUM )
Rule 58    matrix -> ZEROS ( INTNUM )
Rule 59    matrix -> [ vectors ]
Rule 60    vectors -> vector
Rule 61    vectors -> vectors , vector
Rule 62    range_expr -> expression : expression

